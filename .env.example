# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Database ---
# SQLite for local dev. For production swap schema.prisma provider to
# "postgresql" and point this at your Postgres connection string.
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Secret used to sign JWT sessions AND to derive the AES key that encrypts
# SMTP / Microsoft 365 secrets at rest. Use a long random value in production.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Base URL used for links inside notification emails and push notifications.
APP_URL="http://localhost:3000"

# --- Web Push (VAPID) ---
# Generate a key pair:  npx web-push generate-vapid-keys
# The public key is also exposed to the browser via NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_SUBJECT="mailto:you@example.com"
