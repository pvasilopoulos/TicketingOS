# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- App ---
# Base URL used for links inside notification emails and push notifications.
APP_URL="http://localhost:8000"
# Timezone used for display and quiet hours (PHP timezone name).
APP_TIMEZONE="Europe/Athens"
# Show PHP errors in the browser (development only).
APP_DEBUG="0"
# Log pages that run many or slow database queries to storage/logs/queries.log (for tuning; leave off normally).
# DB_PROFILE="1"

# --- Database ---
# sqlite (default, zero setup) or mysql (MariaDB 10.5+ / MySQL 8 — recommended for many tenants).
DB_DRIVER="sqlite"
DB_PATH="storage/database.sqlite"
# DB_HOST="127.0.0.1"
# DB_PORT="3306"
# DB_NAME="ticketingos"
# DB_USER="root"
# DB_PASSWORD=""

# --- Auth ---
# Secret used to sign sessions AND to derive the AES key that encrypts
# SMTP / Microsoft 365 secrets at rest. Use a long random value in production.
# Generate one:  php -r "echo bin2hex(random_bytes(48)), PHP_EOL;"
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Web Push (VAPID) ---
# Generate a key pair:  php bin/vapid-keys.php
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:you@example.com"
# Windows only, if key generation fails: path to openssl.cnf
# OPENSSL_CONF="C:\php\extras\ssl\openssl.cnf"

# --- Background jobs ---
# Secret for GET /cron?key=... when no CLI cron is available (leave empty to disable the URL).
CRON_KEY=
